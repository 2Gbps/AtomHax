{
  "name": "atomhax",
  "version": "0.1.3-b",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:ts": "esbuild inject/src/inject.ts --bundle --outfile=inject/inject.js --format=iife --minify",
    "build:win-x64-fast": "electron-builder --win portable --x64 --config.compression=maximum"
  },
  "author": "AtomHax",
  "license": "GPL-3.0",
  "description": "AtomHax - HaxBall Client",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.atomhax.client",
    "productName": "AtomHax",
    "compression": "maximum",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": ["inject/Haxball-Room-Extension/"],
    "files": [
      "main.js",
      "preload.js",
      "recaptchasolve.js",
      "inject/inject.js",
      "inject/Haxball-Room-Extension/",
      "inject/preferences_default.json",
      "patched/game-min.js"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": {
        "target": "dmg",
        "arch": "universal"
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "linux": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        },
        {
          "target": "deb",
          "arch": "x64"
        }
      ]
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "mpg123-decoder": "^1.0.3",
    "zod": "^4.4.3"
  }
}
